        timing_type : hold_rising;
	fall_constraint(scalar) {
          values("0.24528");
	}
      }
      timing() {
        related_pin : "CLK100MHZ";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("0.03648");
	}
      }
    }
    pin("CLK100MHZ") {
      direction : input;
      clock : true;
      capacitance : 0.0199;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.25888");
	}
	cell_fall(scalar) {
          values("0.34732");
	}
      }
      timing() {
        timing_sense : positive_unate;
        timing_type : max_clock_tree_path;
	cell_rise(scalar) {
