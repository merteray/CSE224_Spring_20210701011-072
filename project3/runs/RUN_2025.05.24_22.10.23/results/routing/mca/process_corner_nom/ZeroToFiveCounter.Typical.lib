	}
      }
      timing() {
        related_pin : "CLK100MHZ";
        timing_type : setup_rising;
	fall_constraint(scalar) {
          values("0.00868");
	}
      }
    }
    pin("CLK100MHZ") {
      direction : input;
      clock : true;
      capacitance : 0.0187;
      timing() {
        timing_sense : positive_unate;
        timing_type : min_clock_tree_path;
	cell_rise(scalar) {
          values("0.25173");
	}
	cell_fall(scalar) {
          values("0.34052");
	}
      }
      timing() {
        timing_sense : positive_unate;
